class Solution {
    public int maxVowels(String s, int k) {
        int len=s.length();
        int max=0,l=0,sum=0;
        int count=0;
        for(int i=0;i<k;i++){
            if(isvowel(s.charAt(i))){
                count++;
            }
        } 
        max=count;
        for(int j=k;j<len;j++){
            if(isvowel(s.charAt(j))){
                count++;
            }
            if(isvowel(s.charAt(l++))){
                count--;
            }
            max=Math.max(count,max);
        }
            return max;
        }
         boolean isvowel(char ch){
        return "aeiou".indexOf(ch)!=-1;
         }
    
    }
